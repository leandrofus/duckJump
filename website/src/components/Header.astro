---
interface Props {
  onHero?: boolean;
  lang?: 'en' | 'es';
}

const { onHero = false, lang = 'en' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const isEs = lang === 'es';
---

<header class={`top ${onHero ? 'on-hero' : ''}`}>
  <nav class="wrap bar" aria-label="Main">
    <a class="brand" href={isEs ? `${baseUrl}/es/` : `${baseUrl}/`}>
      <img src={`${baseUrl}/brand/duckjump-icon.svg`} alt="duckJump" width="36" height="36" />
      <span>duckJump</span>
    </a>

    <span class="grow"></span>

    <a href={`${baseUrl}/docs/`}>
      {isEs ? 'Documentación' : 'Documentation'}
    </a>
    <a href={isEs ? `${baseUrl}/es/#vs-guacamole` : `${baseUrl}/#vs-guacamole`} class="hide-sm">
      {isEs ? 'vs Guacamole' : 'vs Guacamole'}
    </a>
    <a href={isEs ? `${baseUrl}/es/#features` : `${baseUrl}/#features`} class="hide-sm">
      {isEs ? 'Características' : 'Features'}
    </a>
    <a href={isEs ? `${baseUrl}/es/#architecture` : `${baseUrl}/#architecture`} class="hide-sm">
      {isEs ? 'Arquitectura' : 'Architecture'}
    </a>
    <a class="hide-sm" href="https://github.com/leandrofus/duckJump/releases" target="_blank" rel="noopener noreferrer">
      {isEs ? 'Lanzamientos' : 'Releases'}
    </a>

    <!-- GitHub Icon -->
    <a href="https://github.com/leandrofus/duckJump" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
      <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/>
      </svg>
    </a>

    <!-- Language Selector Menu -->
    <details class="langmenu">
      <summary aria-label={isEs ? 'Idioma: Español' : 'Language: English'}>
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
          <path d="M2 12h20"/>
        </svg>
        <span class="lang-name">{isEs ? 'Español' : 'English'}</span>
        <span class="lang-code">{isEs ? 'ES' : 'EN'}</span>
        <span class="chev">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </span>
      </summary>
      <ul>
        <li>
          <a href={`${baseUrl}/`} hreflang="en" lang="en" aria-current={!isEs ? "true" : undefined}>
            English
            {!isEs && (
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6 9 17l-5-5"/>
              </svg>
            )}
          </a>
        </li>
        <li>
          <a href={`${baseUrl}/es/`} hreflang="es" lang="es" aria-current={isEs ? "true" : undefined}>
            Español
            {isEs && (
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6 9 17l-5-5"/>
              </svg>
            )}
          </a>
        </li>
      </ul>
    </details>
  </nav>
</header>

<script>
  const e = document.querySelector(".langmenu");
  document.addEventListener("click", (n) => {
    if (e && (e as HTMLDetailsElement).open && !e.contains(n.target as Node)) {
      (e as HTMLDetailsElement).open = false;
    }
  });
  document.addEventListener("keydown", (n) => {
    if (n.key === "Escape" && e && (e as HTMLDetailsElement).open) {
      (e as HTMLDetailsElement).open = false;
      e.querySelector("summary")?.focus();
    }
  });
</script>
