---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  currentSlug: string;
  lang?: 'en' | 'es';
}

const { title, description, currentSlug, lang = 'en' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const isEs = lang === 'es';

const navSections = [
  {
    title: isEs ? "Comenzando" : "Getting Started",
    links: [
      { label: isEs ? "Visión general y guía rápida" : "Overview & Quickstart", href: `${baseUrl}/docs/`, slug: "index" },
      { label: isEs ? "Configuración y CLI" : "Configuration & CLI", href: `${baseUrl}/docs/cli-configuration/`, slug: "cli-configuration" },
    ],
  },
  {
    title: isEs ? "Arquitectura interna" : "Architecture & Internals",
    links: [
      { label: isEs ? "Arquitectura y protocolo DJTP" : "Architecture & DJTP Protocol", href: `${baseUrl}/docs/architecture/`, slug: "architecture" },
    ],
  },
  {
    title: isEs ? "Seguridad y PAM" : "Security & PAM",
    links: [
      { label: isEs ? "Bóveda de credenciales y pinning" : "Credential Vault & Key Pinning", href: `${baseUrl}/docs/security/`, slug: "security" },
      { label: isEs ? "Permisos Just-In-Time (JIT)" : "Access Grants & JIT PAM", href: `${baseUrl}/docs/pam-grants/`, slug: "pam-grants" },
      { label: isEs ? "Auditoría encadenada e inmutable" : "Tamper-Evident Audit Logs", href: `${baseUrl}/docs/audit-logging/`, slug: "audit-logging" },
    ],
  },
  {
    title: isEs ? "Despliegues avanzados" : "Advanced Deployments",
    links: [
      { label: isEs ? "PostgreSQL y Alta Disponibilidad (HA)" : "PostgreSQL & High Availability (HA)", href: `${baseUrl}/docs/postgresql-ha/`, slug: "postgresql-ha" },
      { label: isEs ? "Agentes de borde en redes cerradas" : "Edge Agents & Closed Networks", href: `${baseUrl}/docs/edge-agents/`, slug: "edge-agents" },
      { label: isEs ? "Grabación de sesiones y S3" : "Session Recordings & S3 Storage", href: `${baseUrl}/docs/recordings-s3/`, slug: "recordings-s3" },
    ],
  },
  {
    title: isEs ? "API y Desarrolladores" : "API & Developers",
    links: [
      { label: isEs ? "API REST y OpenAPI 3.1" : "REST API & OpenAPI 3.1", href: `${baseUrl}/docs/api/`, slug: "api" },
    ],
  },
];
---

<Layout title={`${title} — duckJump Documentation`} description={description} lang={lang}>
  <Header onHero={false} lang={lang} />

  <div class="wrap" style="padding-top: 40px; padding-bottom: 60px;">
    
    <!-- Mobile Navigation Details Menu -->
    <div style="display: block; margin-bottom: 24px;" class="lg:hidden">
      <details style="border: 1px solid var(--rule); border-radius: 12px; background: var(--card); padding: 14px 18px;">
        <summary style="cursor: pointer; font-weight: 600; color: var(--link); list-style: none; display: flex; justify-content: space-between; align-items: center;">
          <span>{isEs ? 'Menú de Documentación' : 'Documentation Menu'}: {title}</span>
          <span style="font-size: 12px;">▼</span>
        </summary>
        <div style="padding-top: 14px; margin-top: 10px; border-top: 1px solid var(--rule);">
          {navSections.map(sec => (
            <div style="margin-bottom: 16px;">
              <div style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); margin-bottom: 6px;">
                {sec.title}
              </div>
              <ul style="list-style: none; padding-left: 8px; margin: 0;">
                {sec.links.map(link => (
                  <li style="margin-bottom: 6px;">
                    <a
                      href={link.href}
                      style={`font-size: 14px; text-decoration: none; ${
                        currentSlug === link.slug
                          ? 'color: var(--duck); font-weight: 600;'
                          : 'color: var(--ink);'
                      }`}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </details>
    </div>

    <!-- Desktop Grid -->
    <div style="display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 48px; align-items: start;">
      
      <!-- Desktop Sidebar -->
      <aside style="position: sticky; top: 92px; max-height: calc(100vh - 110px); overflow-y: auto; padding-right: 16px; border-right: 1px solid var(--rule);" class="hidden lg:block">
        <div style="font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--link); margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
          </svg>
          {isEs ? 'Documentación' : 'Documentation'}
        </div>

        {navSections.map(sec => (
          <div style="margin-bottom: 24px;">
            <div style="font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); margin-bottom: 8px;">
              {sec.title}
            </div>
            <ul style="list-style: none; padding: 0; margin: 0; font-size: 13.5px;">
              {sec.links.map(link => (
                <li style="margin-bottom: 4px;">
                  <a
                    href={link.href}
                    style={`display: block; padding: 6px 10px; border-radius: 8px; text-decoration: none; transition: all 0.15s; ${
                      currentSlug === link.slug
                        ? 'background: color-mix(in srgb, var(--duck) 20%, transparent); color: var(--duck); font-weight: 600;'
                        : 'color: var(--ink);'
                    }`}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}

        <div style="padding-top: 16px; border-top: 1px solid var(--rule); font-size: 13px;">
          <a
            href="https://github.com/leandrofus/duckJump"
            target="_blank"
            rel="noopener noreferrer"
            style="color: var(--muted); text-decoration: none; display: flex; align-items: center; gap: 6px;"
          >
            <span>GitHub repository</span>
            <span>↗</span>
          </a>
        </div>
      </aside>

      <!-- Main Docs Article -->
      <main style="min-width: 0; max-width: 820px;">
        <article class="docs-prose">
          <slot />
        </article>
      </main>

    </div>

  </div>

  <Footer lang={lang} />
</Layout>
