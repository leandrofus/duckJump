    <!-- Una reimaginación de Apache Guacamole -->
    <GuacamoleComparison lang="es" />

    <!-- Accede a cualquier host, sin exponer credenciales + Diseñado para estar junto a producción -->
    <Architecture lang="es" />
  </main>

  <!-- Footer -->
  <Footer lang="es" />
