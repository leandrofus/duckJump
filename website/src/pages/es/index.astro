import GuacamoleComparison from '../../components/GuacamoleComparison.astro';
import Architecture from '../../components/Architecture.astro';
import Footer from '../../components/Footer.astro';
---

<Layout 
  lang="es"
  title="duckJump — Bastión PAM sin clientes en Go y Rust"
  description="Reimaginación de Apache Guacamole: terminal y escritorio web con bóveda de credenciales cifrada, permisos JIT temporales y auditoría a prueba de manipulación."
>
  <!-- Hero Section con Header y Ondas -->
  <Hero lang="es" />

  <!-- Sección de Instalación sobrepuesta -->
  <Quickstart lang="es" />

  <!-- Secciones Principales -->
  <main>
    <!-- Lo que obtienes en el navegador -->
