{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "duckJump Assist",
  "version": "0.1.0",
  "identifier": "com.duckjump.assist",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "duckJump Assist — Asistencia remota",
        "width": 520,
        "height": 720,
        "minWidth": 420,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "msi"
    ],
    "category": "Utility",
    "shortDescription": "Asistencia remota atendida de duckJump",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "duckjump-assist.desktop"
      },
      "rpm": {
        "desktopTemplate": "duckjump-assist.desktop"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "duckjump-assist"
        ]
      }
    }
  }
}
