[Unit]
Description=DuckJump session daemon (duckjumpd: SSH, VNC, RDP)
Documentation=https://github.com/leandrofus/duckJump
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=duckjump
Group=duckjump
# Loopback only: the gateway hands duckjumpd live credentials.
Environment=DUCKJUMPD_LISTEN=127.0.0.1:4823
Environment=DUCKJUMPD_RECORDINGS=/var/lib/duckjump/recordings
Environment=DUCKJUMPD_RDP_WORKER=/usr/libexec/duckjump/duckjumpd-rdp
EnvironmentFile=-/etc/duckjump/duckjump.env
# Shared secret with the gateway (root-only file, read through systemd).
LoadCredential=duckjumpd-token:/etc/duckjump/duckjumpd.token
ExecStart=/usr/libexec/duckjump/duckjumpd
Restart=on-failure
RestartSec=3
StateDirectory=duckjump duckjump/recordings
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
