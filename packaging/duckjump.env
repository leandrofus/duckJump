# DuckJump options. Restart after editing:
#   sudo systemctl restart duckjumpd duckjump

# Where the web UI listens (HTTPS). Port 443 works too.
#DUCKJUMP_LISTEN=0.0.0.0:8443

# Public base URL where users access DuckJump (used for support sessions, join links, edge agent commands).
# Set this to your external host and port (e.g. https://dc1:8442 or https://bastion.example.com:8443).
#DUCKJUMP_FRONTEND_URL=https://127.0.0.1:8443

# TLS certificate. On first start a self-signed one is created at these
# paths; point them to a real certificate (readable by the duckjump user).
#DUCKJUMP_TLS_CERT=/var/lib/duckjump/tls/cert.pem
#DUCKJUMP_TLS_KEY=/var/lib/duckjump/tls/key.pem

# Extra gateway flags. Edge agents (hosts in closed networks) connect to
# their own port, e.g.:
#DUCKJUMP_OPTS=-agent-listen 0.0.0.0:18443

# Behind a reverse proxy (nginx, Traefik…): its addresses, so login rate
# limits and the audit log see the real client, and the cookie is Secure.
#DUCKJUMP_TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
#DUCKJUMP_SECURE_COOKIES=1

# Copy every audit event as it happens to where nobody on this host can
# rewrite it (comma-separated): remote syslog, or a file on WORM storage.
#DUCKJUMP_AUDIT_EXPORT=syslog+tcp://siem.example.com:514,file:///mnt/worm/duckjump-audit.jsonl

# Pin server keys on first use instead of waiting for an admin to approve
# them (Connections → key waiting for approval). Not recommended.
#DUCKJUMP_TRUST_ON_FIRST_USE=1

# duckjumpd on another host: encrypt the gateway <-> duckjumpd link (it carries
# live credentials) and the edge relay. duckjumpd needs --tls-cert/--tls-key;
# pin its certificate here (`duckjumpd --tls-cert … --print-fingerprint`).
#DUCKJUMPD_ADDR=10.0.0.20:4823
#DUCKJUMPD_TLS=1
#DUCKJUMPD_TLS_FINGERPRINT=SHA256:…
#DUCKJUMP_RELAY_TLS=1

# Single sign-on (OpenID Connect). Register a confidential client with the
# redirect URI below. The secret file must be readable by the duckjump user
# (root:duckjump, 0640).
#DUCKJUMP_OIDC_ISSUER=https://keycloak.example.com/realms/corp
#DUCKJUMP_OIDC_CLIENT_ID=duckjump
#DUCKJUMP_OIDC_CLIENT_SECRET_FILE=/etc/duckjump/oidc-client-secret
#DUCKJUMP_OIDC_REDIRECT_URL=https://bastion.example.com:8443/api/v1/auth/oidc/callback
#DUCKJUMP_OIDC_NAME=Corporate login
# Roles from the provider (else admins set them in DuckJump):
#DUCKJUMP_OIDC_ROLES_CLAIM=realm_access.roles
#DUCKJUMP_OIDC_ROLE_MAP=duckjump-superadmin=superadmin,duckjump-admin=admin,duckjump-auditor=auditor

# Database: SQLite in /var/lib/duckjump by default. After
# `sudo duckjump migrate-to-postgres -to postgres://…`:
#DUCKJUMP_DB=postgres://duckjump:secret@db.example.com:5432/duckjump?sslmode=verify-full

# Finished recordings to S3-compatible storage (read by both services).
# The secret file must be readable by the duckjump user.
#DUCKJUMP_S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
#DUCKJUMP_S3_BUCKET=duckjump-recordings
#DUCKJUMP_S3_REGION=eu-west-1
#DUCKJUMP_S3_ACCESS_KEY=AKIA…
#DUCKJUMP_S3_SECRET_KEY_FILE=/etc/duckjump/s3-secret-key
#DUCKJUMP_S3_PATH_STYLE=1   # MinIO

# Log level of duckjumpd (error, warn, info, debug).
#RUST_LOG=info,russh=warn
