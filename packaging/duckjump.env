# DuckJump options. Restart after editing:
#   sudo systemctl restart duckjump-paltad duckjump

# Where the web UI listens (HTTPS). Port 443 works too.
#DUCKJUMP_LISTEN=0.0.0.0:8443

# TLS certificate. On first start a self-signed one is created at these
# paths; point them to a real certificate (readable by the duckjump user).
#PALTA_TLS_CERT=/var/lib/duckjump/tls/cert.pem
#PALTA_TLS_KEY=/var/lib/duckjump/tls/key.pem

# Extra gateway flags. Edge agents (hosts in closed networks) connect to
# their own port, e.g.:
#DUCKJUMP_OPTS=-agent-listen 0.0.0.0:18443

# Log level of paltad (error, warn, info, debug).
#RUST_LOG=info,russh=warn
