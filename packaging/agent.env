# DuckJump edge agent. Create the site in the web UI (Sites → New site),
# put its token in /etc/duckjump-agent/token and then:
#   sudo systemctl restart duckjump-agent

# The gateway's agent endpoint (its -agent-listen port).
DUCKJUMP_AGENT_SERVER=wss://bastion.example.com:18443/agent/connect

# What the gateway may reach through this agent: CIDR[:port,port], separated
# by spaces. Empty denies everything.
DUCKJUMP_AGENT_ALLOW=10.0.0.0/8:22,3389,5900

# For a gateway with a self-signed certificate: a copy of its cert.pem.
#DUCKJUMP_AGENT_CA=/etc/duckjump-agent/gateway.pem
